<!-- Colours and shared styles. The greys build on NightPDF's #1e1e1e and
	#2d2d2d, the accent is the splash border's gradient. -->
<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ResourceDictionary.ThemeDictionaries>
		<!-- the app is always dark (App.xaml), so Default is the only one -->
		<ResourceDictionary x:Key="Default">
			<SolidColorBrush x:Key="SableTitleBarBrush" Color="#1a1a1a" />
			<SolidColorBrush x:Key="SablePaneBrush" Color="#1e1e1e" />
			<SolidColorBrush x:Key="SableContentBrush" Color="#232323" />
			<!-- pdf.js's dark body background (web/viewer.css), which is what
				NightPDF showed around the pages -->
			<SolidColorBrush x:Key="SableViewerBrush" Color="#2a2a2e" />
			<SolidColorBrush x:Key="SableSettingsButtonBrush" Color="#29292c" />
			<SolidColorBrush x:Key="SableSettingsShortcutBrush" Color="#262629" />
			<SolidColorBrush x:Key="SablePopupBrush" Color="#2d2d2d" />
			<SolidColorBrush x:Key="SableCardBrush" Color="#2b2b2b" />
			<SolidColorBrush x:Key="SableCardHoverBrush" Color="#323232" />
			<SolidColorBrush x:Key="SableCardPressedBrush" Color="#282828" />
			<SolidColorBrush x:Key="SableCardBorderBrush" Color="#353535" />
			<SolidColorBrush x:Key="SableDividerBrush" Color="#333333" />
			<SolidColorBrush x:Key="SableTextBrush" Color="#e8e8e8" />
			<SolidColorBrush x:Key="SableTextSecondaryBrush" Color="#a6a6a6" />
			<SolidColorBrush x:Key="SableTextTertiaryBrush" Color="#7a7a7a" />

			<!-- NavigationView's own keys, so the pane reads like part of the
				app and not like the Settings app -->
			<SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#1e1e1e" />
			<SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#1e1e1e" />
			<SolidColorBrush x:Key="NavigationViewContentBackground" Color="#232323" />
			<SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#2f2f2f" />
			<LinearGradientBrush x:Key="NavigationViewSelectionIndicatorForeground" StartPoint="0.5,1" EndPoint="0.5,0">
				<GradientStop Offset="0" Color="#29c0ea" />
				<GradientStop Offset="0.683" Color="#d773e9" />
				<GradientStop Offset="1" Color="#fc515d" />
			</LinearGradientBrush>
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

	<Color x:Key="SableCyan">#29c0ea</Color>
	<Color x:Key="SableViolet">#d773e9</Color>
	<Color x:Key="SableCoral">#fc515d</Color>

	<!-- left to right version of the splash gradient, for buttons -->
	<LinearGradientBrush x:Key="SableAccentGradient" StartPoint="0,0.5" EndPoint="1,0.5">
		<GradientStop Offset="0" Color="#29c0ea" />
		<GradientStop Offset="0.683" Color="#d773e9" />
		<GradientStop Offset="1" Color="#fc515d" />
	</LinearGradientBrush>

	<CornerRadius x:Key="SableCardCornerRadius">8</CornerRadius>

	<!-- the big "Open a PDF" button: the gradient, white text, a light wash
		on hover -->
	<Style x:Key="SableAccentButtonStyle" TargetType="Button">
		<Setter Property="Foreground" Value="#ffffff" />
		<Setter Property="Background" Value="{StaticResource SableAccentGradient}" />
		<Setter Property="Padding" Value="22,9" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="UseSystemFocusVisuals" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid x:Name="Root" Background="{TemplateBinding Background}"
						CornerRadius="{TemplateBinding CornerRadius}">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="Wash.Opacity" Value="0.14" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="Wash.Opacity" Value="0.06" />
										<Setter Target="Root.Opacity" Value="0.85" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="Root.Opacity" Value="0.4" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<Rectangle x:Name="Wash" Fill="White" Opacity="0" />
						<ContentPresenter Padding="{TemplateBinding Padding}"
							Foreground="{TemplateBinding Foreground}"
							Content="{TemplateBinding Content}"
							ContentTemplate="{TemplateBinding ContentTemplate}"
							HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- NightPDF's preset buttons (index.sass L105-133): 14px, weight 600, 4px 8px
		padding, 6px radius, 2px rgb(30,30,30) border that goes rgb(121,121,121)
		on hover. Each button sets its own colours. -->
	<Style x:Key="SablePresetButtonStyle" TargetType="Button">
		<Setter Property="FontSize" Value="14" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Padding" Value="8,4" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="BorderThickness" Value="2" />
		<Setter Property="BorderBrush" Value="#1e1e1e" />
		<Setter Property="UseSystemFocusVisuals" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="Chip" Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="{TemplateBinding CornerRadius}">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="Chip.BorderBrush" Value="#797979" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="Chip.BorderBrush" Value="#797979" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<ContentPresenter Padding="{TemplateBinding Padding}"
							Foreground="{TemplateBinding Foreground}"
							Content="{TemplateBinding Content}" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- the tools strip and other quiet buttons -->
	<Style x:Key="SableFlatButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="10,8" />
		<Setter Property="CornerRadius" Value="4" />
	</Style>

	<!-- icon buttons on the viewer's right rail -->
	<Style x:Key="SableRailButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Width" Value="40" />
		<Setter Property="Height" Value="36" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<!-- a click leaves the keyboard focus on the pages -->
		<Setter Property="AllowFocusOnInteraction" Value="False" />
	</Style>

	<!-- the rail's buttons that open a panel; lit while it's open -->
	<Style x:Key="SableRailToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Width" Value="40" />
		<Setter Property="Height" Value="36" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="AllowFocusOnInteraction" Value="False" />
	</Style>

	<!-- a thumbnail in the thumbnail panel: no chrome of its own, the border
		and highlight are drawn by the viewer like pdf.js's .thumbnail -->
	<Style x:Key="SableThumbnailButtonStyle" TargetType="Button">
		<Setter Property="Padding" Value="0" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="AllowFocusOnInteraction" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<ContentPresenter Background="{TemplateBinding Background}"
						Content="{TemplateBinding Content}" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- flat buttons that sit in the title bar (the Menu button) -->
	<Style x:Key="SableTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="10,6" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<!-- quiet transport controls; focus remains visible for keyboard use -->
	<Style x:Key="SableMusicButtonStyle" TargetType="Button"
		BasedOn="{StaticResource DefaultButtonStyle}">
		<Setter Property="Width" Value="36" />
		<Setter Property="Height" Value="36" />
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="White" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style x:Key="SableMusicPlayStyle" TargetType="Button"
		BasedOn="{StaticResource SableMusicButtonStyle}">
		<Setter Property="Width" Value="44" />
		<Setter Property="Height" Value="44" />
		<Setter Property="CornerRadius" Value="22" />
		<Setter Property="Background" Value="White" />
		<Setter Property="Foreground" Value="#202020" />
	</Style>
	<Style x:Key="SableMusicToggleStyle" TargetType="ToggleButton">
		<Setter Property="Width" Value="36" />
		<Setter Property="Height" Value="36" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="UseSystemFocusVisuals" Value="True" />
		<Setter Property="Foreground" Value="White" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToggleButton">
					<Grid Background="Transparent" CornerRadius="4">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="Hover.Background" Value="#15FFFFFF" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="Hover.Background" Value="#25FFFFFF" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="Body.Opacity" Value="0.3" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
							<VisualStateGroup x:Name="CheckStates">
								<VisualState x:Name="Unchecked" />
								<VisualState x:Name="Checked">
									<VisualState.Setters>
										<Setter Target="Glyph.Opacity" Value="1" />
										<Setter Target="Dot.Opacity" Value="1" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<Grid x:Name="Body">
							<Border x:Name="Hover" CornerRadius="4" />
							<ContentPresenter x:Name="Glyph" Content="{TemplateBinding Content}"
								Foreground="{TemplateBinding Foreground}" Opacity="0.5"
								HorizontalAlignment="Center" VerticalAlignment="Center" />
							<Ellipse x:Name="Dot" Width="3" Height="3" Fill="White" Opacity="0"
								VerticalAlignment="Bottom" Margin="0,0,0,1" />
						</Grid>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!-- retain Slider's native input/automation with its horizontal parts -->
	<Style x:Key="SableMusicSeekStyle" TargetType="Slider">
		<Setter Property="Background" Value="#33FFFFFF" />
		<Setter Property="Height" Value="24" />
		<Setter Property="UseSystemFocusVisuals" Value="True" />
		<Setter Property="IsFocusEngagementEnabled" Value="True" />
		<Setter Property="ManipulationMode" Value="None" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Slider">
					<Grid x:Name="SliderContainer" Background="Transparent">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="HorizontalThumb.Opacity" Value="1" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="HorizontalThumb.Opacity" Value="1" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="HorizontalTemplate.Opacity" Value="0.35" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
							<VisualStateGroup x:Name="FocusStates">
								<VisualState x:Name="Unfocused" />
								<VisualState x:Name="Focused">
									<VisualState.Setters>
										<Setter Target="HorizontalThumb.Opacity" Value="1" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PointerFocused" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<Grid x:Name="HorizontalTemplate" ColumnDefinitions="Auto,Auto,*">
							<Rectangle x:Name="HorizontalTrackRect" Grid.ColumnSpan="3"
								Fill="{TemplateBinding Background}" Height="4" RadiusX="2" RadiusY="2" />
							<Rectangle x:Name="HorizontalDecreaseRect"
								Fill="{TemplateBinding Foreground}" Height="4" RadiusX="2" RadiusY="2" />
							<Thumb x:Name="HorizontalThumb" Grid.Column="1" Width="12" Height="12"
								Opacity="0" AutomationProperties.AccessibilityView="Raw">
								<Thumb.Template>
									<ControlTemplate TargetType="Thumb">
										<Ellipse Fill="White" />
									</ControlTemplate>
								</Thumb.Template>
							</Thumb>
						</Grid>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- quiet settings controls with the native keyboard focus outline -->
	<Style x:Key="SableSettingsButtonStyle" TargetType="Button">
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="Background" Value="{ThemeResource SableSettingsButtonBrush}" />
		<Setter Property="BorderBrush" Value="#3b3b3f" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Foreground" Value="#eeeeef" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="MinHeight" Value="36" />
		<Setter Property="Padding" Value="12,8" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="UseSystemFocusVisuals" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid x:Name="SettingsRoot" Background="Transparent"
						CornerRadius="{TemplateBinding CornerRadius}">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="SettingsWash.Opacity" Value="0.05" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="SettingsWash.Opacity" Value="0.09" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="SettingsRoot.Opacity" Value="0.4" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<Border Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{TemplateBinding CornerRadius}" />
						<Border x:Name="SettingsWash" Background="White" Opacity="0"
							IsHitTestVisible="False"
							CornerRadius="{TemplateBinding CornerRadius}" />
						<ContentPresenter Content="{TemplateBinding Content}"
							ContentTemplate="{TemplateBinding ContentTemplate}"
							ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
							Padding="{TemplateBinding Padding}"
							Margin="{TemplateBinding BorderThickness}"
							Foreground="{TemplateBinding Foreground}"
							FontFamily="{TemplateBinding FontFamily}"
							FontSize="{TemplateBinding FontSize}"
							FontWeight="{TemplateBinding FontWeight}"
							FontStyle="{TemplateBinding FontStyle}"
							CharacterSpacing="{TemplateBinding CharacterSpacing}"
							HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="SableSettingsNavStyle" TargetType="Button"
		BasedOn="{StaticResource SableSettingsButtonStyle}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="MinHeight" Value="42" />
	</Style>
	<Style x:Key="SableSettingsShortcutStyle" TargetType="Button"
		BasedOn="{StaticResource SableSettingsButtonStyle}">
		<Setter Property="Background" Value="{ThemeResource SableSettingsShortcutBrush}" />
		<Setter Property="BorderBrush" Value="#38383d" />
		<Setter Property="Padding" Value="10,7" />
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="MinHeight" Value="32" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
	</Style>
	<Style x:Key="SableSettingsClearStyle" TargetType="Button"
		BasedOn="{StaticResource SableSettingsButtonStyle}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Width" Value="28" />
		<Setter Property="Height" Value="32" />
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="MinHeight" Value="0" />
	</Style>
	<Style x:Key="SableSettingsPrimaryStyle" TargetType="Button"
		BasedOn="{StaticResource SableSettingsButtonStyle}">
		<Setter Property="Background" Value="#eeeeef" />
		<Setter Property="Foreground" Value="#202023" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="18,8" />
	</Style>
</ResourceDictionary>
