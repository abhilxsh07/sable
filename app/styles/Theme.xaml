<!-- Colours and shared styles. The greys build on NightPDF's #1e1e1e and
	#2d2d2d, the accent is the splash border's gradient. -->
<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ResourceDictionary.ThemeDictionaries>
		<!-- the app is always dark (App.xaml); Default is that dark look and
			HighContrast below follows a Windows contrast theme -->
		<ResourceDictionary x:Key="Default">
			<SolidColorBrush x:Key="SableTitleBarBrush" Color="#1a1a1a" />
			<SolidColorBrush x:Key="SablePaneBrush" Color="#1e1e1e" />
			<SolidColorBrush x:Key="SableContentBrush" Color="#232323" />
			<!-- pdf.js's dark body background (web/viewer.css), which is what
				NightPDF showed around the pages -->
			<SolidColorBrush x:Key="SableViewerBrush" Color="#2a2a2e" />
			<SolidColorBrush x:Key="SableSettingsButtonBrush" Color="#29292c" />
			<SolidColorBrush x:Key="SableSettingsShortcutBrush" Color="#262629"
				/>
			<SolidColorBrush x:Key="SablePopupBrush" Color="#2d2d2d" />
			<SolidColorBrush x:Key="SableCardBrush" Color="#2b2b2b" />
			<SolidColorBrush x:Key="SableCardHoverBrush" Color="#323232" />
			<SolidColorBrush x:Key="SableCardPressedBrush" Color="#282828" />
			<SolidColorBrush x:Key="SableCardBorderBrush" Color="#353535" />
			<SolidColorBrush x:Key="SableDividerBrush" Color="#333333" />
			<SolidColorBrush x:Key="SableTextBrush" Color="#e8e8e8" />
			<SolidColorBrush x:Key="SableTextSecondaryBrush" Color="#a6a6a6" />
			<SolidColorBrush x:Key="SableTextTertiaryBrush" Color="#7a7a7a" />

			<!-- NavigationView's own keys, so the pane reads like part of the
				app and not like the Settings app -->
			<SolidColorBrush x:Key="NavigationViewExpandedPaneBackground"
				Color="#1e1e1e" />
			<SolidColorBrush x:Key="NavigationViewDefaultPaneBackground"
				Color="#1e1e1e" />
			<SolidColorBrush x:Key="NavigationViewContentBackground"
				Color="#232323" />
			<SolidColorBrush x:Key="NavigationViewContentGridBorderBrush"
				Color="#2f2f2f" />
			<LinearGradientBrush
				x:Key="NavigationViewSelectionIndicatorForeground"
				StartPoint="0.5,1" EndPoint="0.5,0">
				<GradientStop Offset="0" Color="#29c0ea" />
				<GradientStop Offset="0.683" Color="#d773e9" />
				<GradientStop Offset="1" Color="#fc515d" />
			</LinearGradientBrush>
			<!-- the gradient and the fixed control colours, kept here so the
				contrast theme can swap them -->
			<LinearGradientBrush x:Key="SableAccentGradient"
				StartPoint="0,0.5" EndPoint="1,0.5">
				<GradientStop Offset="0" Color="#29c0ea" />
				<GradientStop Offset="0.683" Color="#d773e9" />
				<GradientStop Offset="1" Color="#fc515d" />
			</LinearGradientBrush>
			<SolidColorBrush x:Key="SableAccentForegroundBrush" Color="#ffffff" />
			<SolidColorBrush x:Key="SablePresetBorderBrush" Color="#1e1e1e" />
			<SolidColorBrush x:Key="SablePresetHoverBorderBrush"
				Color="#797979" />
			<SolidColorBrush x:Key="SableMusicPlayForegroundBrush"
				Color="#202020" />
			<SolidColorBrush x:Key="SableMusicHoverBrush" Color="#15FFFFFF" />
			<SolidColorBrush x:Key="SableMusicPressedBrush" Color="#25FFFFFF" />
			<SolidColorBrush x:Key="SableMusicSeekBrush" Color="#33FFFFFF" />
			<!-- Home's tool tiles: the icon colour on a 15% wash of a tint -->
			<SolidColorBrush x:Key="SableToolOpenTileBrush" Color="#2629c0ea" />
			<SolidColorBrush x:Key="SableToolOpenIconBrush" Color="#29c0ea" />
			<SolidColorBrush x:Key="SableToolCombineTileBrush"
				Color="#26d773e9" />
			<SolidColorBrush x:Key="SableToolCombineIconBrush"
				Color="#d773e9" />
			<SolidColorBrush x:Key="SableToolOrganizeTileBrush"
				Color="#26fc515d" />
			<SolidColorBrush x:Key="SableToolOrganizeIconBrush"
				Color="#fc515d" />
			<SolidColorBrush x:Key="SableToolFillSignTileBrush"
				Color="#26c2ad80" />
			<SolidColorBrush x:Key="SableToolFillSignIconBrush"
				Color="#c2ad80" />
			<SolidColorBrush x:Key="SableToolCommentTileBrush"
				Color="#2690a582" />
			<SolidColorBrush x:Key="SableToolCommentIconBrush"
				Color="#a3ba94" />
			<SolidColorBrush x:Key="SableToolExportTileBrush"
				Color="#26bc8b96" />
			<SolidColorBrush x:Key="SableToolExportIconBrush" Color="#d29fab" />
			<SolidColorBrush x:Key="SableToolReadAloudTileBrush"
				Color="#268fb8de" />
			<SolidColorBrush x:Key="SableToolReadAloudIconBrush"
				Color="#8fb8de" />
			<SolidColorBrush x:Key="SableNightModeIconBrush" Color="#d773e9" />
			<!-- the drop card's dashed border: gradient3.svg, bottom to top -->
			<LinearGradientBrush x:Key="SableDropCardStrokeBrush"
				StartPoint="0.52,1" EndPoint="0.48,0">
				<GradientStop Offset="0" Color="#29c0ea" />
				<GradientStop Offset="0.683" Color="#d773e9" />
				<GradientStop Offset="1" Color="#fc515d" />
			</LinearGradientBrush>
			<SolidColorBrush x:Key="SableSettingsBorderBrush" Color="#3b3b3f" />
			<SolidColorBrush x:Key="SableSettingsTextBrush" Color="#eeeeef" />
			<SolidColorBrush x:Key="SableShortcutBorderBrush" Color="#38383d" />
			<SolidColorBrush x:Key="SableSettingsPrimaryBrush" Color="#eeeeef" />
			<SolidColorBrush x:Key="SableSettingsPrimaryTextBrush"
				Color="#202023" />
			<SolidColorBrush x:Key="SableHomeTitleBrush" Color="#cccccc" />
			<SolidColorBrush x:Key="SableHomeHintBrush" Color="#bbbbbb" />
			<SolidColorBrush x:Key="SablePresentationBarBrush" Color="#000000" />
			<SolidColorBrush x:Key="SablePresentationBorderBrush"
				Color="#404040" />
		</ResourceDictionary>
		<!-- Windows contrast themes. Every Sable colour becomes one of the
			theme's system colours, so the user's choice wins. The pages keep
			the night filter the user picked. -->
		<ResourceDictionary x:Key="HighContrast">
			<SolidColorBrush x:Key="SableTitleBarBrush"
				Color="{ThemeResource SystemColorWindowColor}" />
			<SolidColorBrush x:Key="SablePaneBrush"
				Color="{ThemeResource SystemColorWindowColor}" />
			<SolidColorBrush x:Key="SableContentBrush"
				Color="{ThemeResource SystemColorWindowColor}" />
			<SolidColorBrush x:Key="SableViewerBrush"
				Color="{ThemeResource SystemColorWindowColor}" />
			<SolidColorBrush x:Key="SableSettingsButtonBrush"
				Color="{ThemeResource SystemColorButtonFaceColor}" />
			<SolidColorBrush x:Key="SableSettingsShortcutBrush"
				Color="{ThemeResource SystemColorButtonFaceColor}" />
			<SolidColorBrush x:Key="SablePopupBrush"
				Color="{ThemeResource SystemColorWindowColor}" />
			<SolidColorBrush x:Key="SableCardBrush"
				Color="{ThemeResource SystemColorWindowColor}" />
			<SolidColorBrush x:Key="SableCardHoverBrush"
				Color="{ThemeResource SystemColorHighlightColor}" />
			<SolidColorBrush x:Key="SableCardPressedBrush"
				Color="{ThemeResource SystemColorHighlightColor}" />
			<SolidColorBrush x:Key="SableCardBorderBrush"
				Color="{ThemeResource SystemColorWindowTextColor}" />
			<SolidColorBrush x:Key="SableDividerBrush"
				Color="{ThemeResource SystemColorWindowTextColor}" />
			<SolidColorBrush x:Key="SableTextBrush"
				Color="{ThemeResource SystemColorWindowTextColor}" />
			<SolidColorBrush x:Key="SableTextSecondaryBrush"
				Color="{ThemeResource SystemColorWindowTextColor}" />
			<SolidColorBrush x:Key="SableTextTertiaryBrush"
				Color="{ThemeResource SystemColorGrayTextColor}" />
			<SolidColorBrush x:Key="SableAccentForegroundBrush"
				Color="{ThemeResource SystemColorHighlightTextColor}" />
			<SolidColorBrush x:Key="SablePresetBorderBrush"
				Color="{ThemeResource SystemColorButtonTextColor}" />
			<SolidColorBrush x:Key="SablePresetHoverBorderBrush"
				Color="{ThemeResource SystemColorHighlightColor}" />
			<SolidColorBrush x:Key="SableMusicPlayForegroundBrush"
				Color="{ThemeResource SystemColorButtonTextColor}" />
			<SolidColorBrush x:Key="SableMusicHoverBrush"
				Color="{ThemeResource SystemColorHighlightColor}" />
			<SolidColorBrush x:Key="SableMusicPressedBrush"
				Color="{ThemeResource SystemColorHighlightColor}" />
			<SolidColorBrush x:Key="SableMusicSeekBrush"
				Color="{ThemeResource SystemColorGrayTextColor}" />
			<!-- Home's tool tiles, night mode icon and drop card border -->
			<SolidColorBrush x:Key="SableToolOpenTileBrush"
				Color="Transparent" />
			<SolidColorBrush x:Key="SableToolOpenIconBrush"
				Color="{ThemeResource SystemColorButtonTextColor}" />
			<SolidColorBrush x:Key="SableToolCombineTileBrush"
				Color="Transparent" />
			<SolidColorBrush x:Key="SableToolCombineIconBrush"
				Color="{ThemeResource SystemColorButtonTextColor}" />
			<SolidColorBrush x:Key="SableToolOrganizeTileBrush"
				Color="Transparent" />
			<SolidColorBrush x:Key="SableToolOrganizeIconBrush"
				Color="{ThemeResource SystemColorButtonTextColor}" />
			<SolidColorBrush x:Key="SableToolFillSignTileBrush"
				Color="Transparent" />
			<SolidColorBrush x:Key="SableToolFillSignIconBrush"
				Color="{ThemeResource SystemColorButtonTextColor}" />
			<SolidColorBrush x:Key="SableToolCommentTileBrush"
				Color="Transparent" />
			<SolidColorBrush x:Key="SableToolCommentIconBrush"
				Color="{ThemeResource SystemColorButtonTextColor}" />
			<SolidColorBrush x:Key="SableToolExportTileBrush"
				Color="Transparent" />
			<SolidColorBrush x:Key="SableToolExportIconBrush"
				Color="{ThemeResource SystemColorButtonTextColor}" />
			<SolidColorBrush x:Key="SableToolReadAloudTileBrush"
				Color="Transparent" />
			<SolidColorBrush x:Key="SableToolReadAloudIconBrush"
				Color="{ThemeResource SystemColorButtonTextColor}" />
			<SolidColorBrush x:Key="SableNightModeIconBrush"
				Color="{ThemeResource SystemColorWindowTextColor}" />
			<SolidColorBrush x:Key="SableDropCardStrokeBrush"
				Color="{ThemeResource SystemColorHighlightColor}" />
			<SolidColorBrush x:Key="SableSettingsBorderBrush"
				Color="{ThemeResource SystemColorButtonTextColor}" />
			<SolidColorBrush x:Key="SableShortcutBorderBrush"
				Color="{ThemeResource SystemColorButtonTextColor}" />
			<SolidColorBrush x:Key="SableSettingsTextBrush"
				Color="{ThemeResource SystemColorButtonTextColor}" />
			<SolidColorBrush x:Key="SableSettingsPrimaryBrush"
				Color="{ThemeResource SystemColorHighlightColor}" />
			<SolidColorBrush x:Key="SableSettingsPrimaryTextBrush"
				Color="{ThemeResource SystemColorHighlightTextColor}" />
			<SolidColorBrush x:Key="SableAccentGradient"
				Color="{ThemeResource SystemColorHighlightColor}" />
			<SolidColorBrush x:Key="SableHomeTitleBrush"
				Color="{ThemeResource SystemColorWindowTextColor}" />
			<SolidColorBrush x:Key="SableHomeHintBrush"
				Color="{ThemeResource SystemColorWindowTextColor}" />
			<SolidColorBrush x:Key="SablePresentationBarBrush"
				Color="{ThemeResource SystemColorWindowColor}" />
			<SolidColorBrush x:Key="SablePresentationBorderBrush"
				Color="{ThemeResource SystemColorWindowTextColor}" />
			<SolidColorBrush x:Key="NavigationViewExpandedPaneBackground"
				Color="{ThemeResource SystemColorWindowColor}" />
			<SolidColorBrush x:Key="NavigationViewDefaultPaneBackground"
				Color="{ThemeResource SystemColorWindowColor}" />
			<SolidColorBrush x:Key="NavigationViewContentBackground"
				Color="{ThemeResource SystemColorWindowColor}" />
			<SolidColorBrush x:Key="NavigationViewContentGridBorderBrush"
				Color="{ThemeResource SystemColorWindowTextColor}" />
			<SolidColorBrush
				x:Key="NavigationViewSelectionIndicatorForeground"
				Color="{ThemeResource SystemColorHighlightColor}" />
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

	<!-- the Morty alert is portal green in every theme -->
	<SolidColorBrush x:Key="SableMortyBrush" Color="#97CE4C" />
	<SolidColorBrush x:Key="SableMortyTextBrush" Color="#000000" />
	<Style x:Key="SableMortyAlertStyle" TargetType="InfoBar">
		<Setter Property="Title" Value="MORTY!" />
		<Setter Property="Message"
			Value="I'm a PDF reader Morty! I'm PDF reader Rick!!!" />
		<Setter Property="IsClosable" Value="True" />
		<Setter Property="IsIconVisible" Value="False" />
		<Setter Property="Background" Value="{StaticResource SableMortyBrush}"
			/>
		<Setter Property="BorderBrush" Value="{StaticResource SableMortyBrush}"
			/>
		<Setter Property="Foreground"
			Value="{StaticResource SableMortyTextBrush}" />
		<Setter Property="RequestedTheme" Value="Light" />
	</Style>

	<!-- motion tokens, WinUI's own durations and enter spline.
		helpers/motion.h carries the same values for the code. Every exit
		is Faster; nothing runs longer than Normal. -->
	<x:String x:Key="SableMotionFaster">00:00:00.083</x:String>
	<x:String x:Key="SableMotionFast">00:00:00.167</x:String>
	<x:String x:Key="SableMotionNormal">00:00:00.250</x:String>
	<x:String x:Key="SableMotionEnterSpline">0,0,0,1</x:String>
	<x:String x:Key="SableMotionExitSpline">1,0,1,1</x:String>
	<x:Double x:Key="SableMotionSlide">16</x:Double>

	<Color x:Key="SableCyan">#29c0ea</Color>
	<Color x:Key="SableViolet">#d773e9</Color>
	<Color x:Key="SableCoral">#fc515d</Color>

	<!-- SableAccentGradient, the left to right version of the splash
		gradient for buttons, is in the theme dictionaries above -->

	<CornerRadius x:Key="SableCardCornerRadius">8</CornerRadius>

	<!-- the big "Open a PDF" button: the gradient, white text, a light wash
		on hover -->
	<Style x:Key="SableAccentButtonStyle" TargetType="Button">
		<Setter Property="Foreground"
			Value="{ThemeResource SableAccentForegroundBrush}" />
		<Setter Property="Background"
			Value="{ThemeResource SableAccentGradient}" />
		<Setter Property="Padding" Value="22,9" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="UseSystemFocusVisuals" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid x:Name="Root"
						Background="{TemplateBinding Background}"
						CornerRadius="{TemplateBinding CornerRadius}">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="Wash.Opacity"
											Value="0.14" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="Wash.Opacity"
											Value="0.06" />
										<Setter Target="Root.Opacity"
											Value="0.85" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="Root.Opacity"
											Value="0.4" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<Rectangle x:Name="Wash" Fill="White" Opacity="0" />
						<ContentPresenter Padding="{TemplateBinding Padding}"
							Foreground="{TemplateBinding Foreground}"
							Content="{TemplateBinding Content}"
							ContentTemplate="{TemplateBinding ContentTemplate}"
							HorizontalContentAlignment="Center"
							VerticalContentAlignment="Center" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- NightPDF's preset buttons (index.sass L105-133): 14px, weight 600, 4px
	8px
		padding, 6px radius, 2px rgb(30,30,30) border that goes rgb(121,121,121)
		on hover. Each button sets its own colours. -->
	<Style x:Key="SablePresetButtonStyle" TargetType="Button">
		<Setter Property="FontSize" Value="14" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Padding" Value="8,4" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="BorderThickness" Value="2" />
		<Setter Property="BorderBrush"
			Value="{ThemeResource SablePresetBorderBrush}" />
		<Setter Property="UseSystemFocusVisuals" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="Chip"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="{TemplateBinding CornerRadius}">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="Chip.BorderBrush"
											Value="{ThemeResource SablePresetHoverBorderBrush}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="Chip.BorderBrush"
											Value="{ThemeResource SablePresetHoverBorderBrush}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<ContentPresenter Padding="{TemplateBinding Padding}"
							Foreground="{TemplateBinding Foreground}"
							Content="{TemplateBinding Content}" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- the tools strip and other quiet buttons -->
	<Style x:Key="SableFlatButtonStyle" TargetType="Button"
		BasedOn="{StaticResource DefaultButtonStyle}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="10,8" />
		<Setter Property="CornerRadius" Value="4" />
	</Style>

	<!-- icon buttons on the viewer's right rail -->
	<Style x:Key="SableRailButtonStyle" TargetType="Button"
		BasedOn="{StaticResource DefaultButtonStyle}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Width" Value="40" />
		<Setter Property="Height" Value="36" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<!-- a click leaves the keyboard focus on the pages -->
		<Setter Property="AllowFocusOnInteraction" Value="False" />
	</Style>

	<!-- the rail's buttons that open a panel; lit while it's open -->
	<Style x:Key="SableRailToggleButtonStyle" TargetType="ToggleButton"
		BasedOn="{StaticResource DefaultToggleButtonStyle}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Width" Value="40" />
		<Setter Property="Height" Value="36" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="AllowFocusOnInteraction" Value="False" />
	</Style>

	<!-- a thumbnail in the thumbnail panel: no chrome of its own, the border
		and highlight are drawn by the viewer like pdf.js's .thumbnail -->
	<Style x:Key="SableThumbnailButtonStyle" TargetType="Button">
		<Setter Property="Padding" Value="0" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="AllowFocusOnInteraction" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<ContentPresenter Background="{TemplateBinding Background}"
						Content="{TemplateBinding Content}" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- flat buttons that sit in the title bar (the Menu button) -->
	<Style x:Key="SableTitleBarButtonStyle" TargetType="Button"
		BasedOn="{StaticResource DefaultButtonStyle}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="10,6" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<!-- quiet transport controls; focus remains visible for keyboard use -->
	<Style x:Key="SableMusicButtonStyle" TargetType="Button"
		BasedOn="{StaticResource DefaultButtonStyle}">
		<Setter Property="Width" Value="36" />
		<Setter Property="Height" Value="36" />
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="White" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style x:Key="SableMusicPlayStyle" TargetType="Button"
		BasedOn="{StaticResource SableMusicButtonStyle}">
		<Setter Property="Width" Value="44" />
		<Setter Property="Height" Value="44" />
		<Setter Property="CornerRadius" Value="22" />
		<Setter Property="Background" Value="White" />
		<Setter Property="Foreground"
			Value="{ThemeResource SableMusicPlayForegroundBrush}" />
	</Style>
	<Style x:Key="SableMusicToggleStyle" TargetType="ToggleButton">
		<Setter Property="Width" Value="36" />
		<Setter Property="Height" Value="36" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="UseSystemFocusVisuals" Value="True" />
		<Setter Property="Foreground" Value="White" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToggleButton">
					<Grid Background="Transparent" CornerRadius="4">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="Hover.Background"
											Value="{ThemeResource SableMusicHoverBrush}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="Hover.Background"
											Value="{ThemeResource SableMusicPressedBrush}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="Body.Opacity"
											Value="0.3" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
							<VisualStateGroup x:Name="CheckStates">
								<VisualState x:Name="Unchecked" />
								<VisualState x:Name="Checked">
									<VisualState.Setters>
										<Setter Target="Glyph.Opacity" Value="1"
											/>
										<Setter Target="Dot.Opacity" Value="1"
											/>
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<Grid x:Name="Body">
							<Border x:Name="Hover" CornerRadius="4" />
							<ContentPresenter x:Name="Glyph"
								Content="{TemplateBinding Content}"
								Foreground="{TemplateBinding Foreground}"
								Opacity="0.5"
								HorizontalAlignment="Center"
								VerticalAlignment="Center" />
							<Ellipse x:Name="Dot" Width="3" Height="3"
								Fill="White" Opacity="0"
								VerticalAlignment="Bottom" Margin="0,0,0,1" />
						</Grid>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!-- retain Slider's native input/automation with its horizontal parts -->
	<Style x:Key="SableMusicSeekStyle" TargetType="Slider">
		<Setter Property="Background"
			Value="{ThemeResource SableMusicSeekBrush}" />
		<Setter Property="Height" Value="24" />
		<Setter Property="UseSystemFocusVisuals" Value="True" />
		<Setter Property="IsFocusEngagementEnabled" Value="True" />
		<Setter Property="ManipulationMode" Value="None" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Slider">
					<Grid x:Name="SliderContainer" Background="Transparent">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="HorizontalThumb.Opacity"
											Value="1" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="HorizontalThumb.Opacity"
											Value="1" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter
											Target="HorizontalTemplate.Opacity"
											Value="0.35" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
							<VisualStateGroup x:Name="FocusStates">
								<VisualState x:Name="Unfocused" />
								<VisualState x:Name="Focused">
									<VisualState.Setters>
										<Setter Target="HorizontalThumb.Opacity"
											Value="1" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PointerFocused" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<Grid x:Name="HorizontalTemplate"
							ColumnDefinitions="Auto,Auto,*">
							<Rectangle x:Name="HorizontalTrackRect"
								Grid.ColumnSpan="3"
								Fill="{TemplateBinding Background}" Height="4"
								RadiusX="2" RadiusY="2" />
							<Rectangle x:Name="HorizontalDecreaseRect"
								Fill="{TemplateBinding Foreground}" Height="4"
								RadiusX="2" RadiusY="2" />
							<Thumb x:Name="HorizontalThumb" Grid.Column="1"
								Width="12" Height="12"
								Opacity="0"
								AutomationProperties.AccessibilityView="Raw">
								<Thumb.Template>
									<ControlTemplate TargetType="Thumb">
										<Ellipse Fill="White" />
									</ControlTemplate>
								</Thumb.Template>
							</Thumb>
						</Grid>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- quiet settings controls with the native keyboard focus outline -->
	<Style x:Key="SableSettingsButtonStyle" TargetType="Button">
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="Background"
			Value="{ThemeResource SableSettingsButtonBrush}" />
		<Setter Property="BorderBrush"
			Value="{ThemeResource SableSettingsBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Foreground"
			Value="{ThemeResource SableSettingsTextBrush}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="MinHeight" Value="36" />
		<Setter Property="Padding" Value="12,8" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="UseSystemFocusVisuals" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid x:Name="SettingsRoot" Background="Transparent"
						CornerRadius="{TemplateBinding CornerRadius}">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="SettingsWash.Opacity"
											Value="0.05" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="SettingsWash.Opacity"
											Value="0.09" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="SettingsRoot.Opacity"
											Value="0.4" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<Border Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{TemplateBinding CornerRadius}" />
						<Border x:Name="SettingsWash" Background="White"
							Opacity="0"
							IsHitTestVisible="False"
							CornerRadius="{TemplateBinding CornerRadius}" />
						<ContentPresenter Content="{TemplateBinding Content}"
							ContentTemplate="{TemplateBinding ContentTemplate}"
							ContentTemplateSelector=
							"{TemplateBinding ContentTemplateSelector}"
							Padding="{TemplateBinding Padding}"
							Margin="{TemplateBinding BorderThickness}"
							Foreground="{TemplateBinding Foreground}"
							FontFamily="{TemplateBinding FontFamily}"
							FontSize="{TemplateBinding FontSize}"
							FontWeight="{TemplateBinding FontWeight}"
							FontStyle="{TemplateBinding FontStyle}"
							CharacterSpacing=
							"{TemplateBinding CharacterSpacing}"
							HorizontalContentAlignment=
							"{TemplateBinding HorizontalContentAlignment}"
							VerticalContentAlignment=
							"{TemplateBinding VerticalContentAlignment}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="SableSettingsNavStyle" TargetType="Button"
		BasedOn="{StaticResource SableSettingsButtonStyle}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="MinHeight" Value="42" />
	</Style>
	<Style x:Key="SableSettingsShortcutStyle" TargetType="Button"
		BasedOn="{StaticResource SableSettingsButtonStyle}">
		<Setter Property="Background"
			Value="{ThemeResource SableSettingsShortcutBrush}" />
		<Setter Property="BorderBrush"
			Value="{ThemeResource SableShortcutBorderBrush}" />
		<Setter Property="Padding" Value="10,7" />
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="MinHeight" Value="32" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
	</Style>
	<Style x:Key="SableSettingsClearStyle" TargetType="Button"
		BasedOn="{StaticResource SableSettingsButtonStyle}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Width" Value="28" />
		<Setter Property="Height" Value="32" />
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="MinHeight" Value="0" />
	</Style>
	<Style x:Key="SableSettingsPrimaryStyle" TargetType="Button"
		BasedOn="{StaticResource SableSettingsButtonStyle}">
		<Setter Property="Background"
			Value="{ThemeResource SableSettingsPrimaryBrush}" />
		<Setter Property="Foreground"
			Value="{ThemeResource SableSettingsPrimaryTextBrush}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="18,8" />
	</Style>
</ResourceDictionary>
