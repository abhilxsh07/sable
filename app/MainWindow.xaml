<Window
	x:Class="Sable.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Sable"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	Title="Sable">

	<Grid x:Name="RootGrid" RowDefinitions="Auto,*" Background="{ThemeResource SablePaneBrush}"
		Tapped="onHideConfigurator" KeyDown="onFilterKeyDown">
		<!-- my own title bar instead of the system one. The Menu button takes
			the place of NightPDF's menu bar (menutemplate.ts), same items, same
			shortcuts. Tabs and presets share the bar. -->
		<TitleBar x:Name="AppTitleBar" Title="Sable"
			IsBackButtonVisible="False" IsPaneToggleButtonVisible="False"
			Background="{ThemeResource SableTitleBarBrush}">
			<TitleBar.Resources>
				<!-- the title bar centres content by default; tabs start left -->
				<HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Left</HorizontalAlignment>
			</TitleBar.Resources>
			<TitleBar.IconSource>
				<ImageIconSource ImageSource="ms-appx:///assets/icon.png" />
			</TitleBar.IconSource>
			<TitleBar.LeftHeader>
				<Button x:Name="MenuButton" Style="{StaticResource SableTitleBarButtonStyle}"
					Margin="4,0,0,0" ToolTipService.ToolTip="Menu"
					AutomationProperties.Name="Menu">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<FontIcon Glyph="&#xE700;" FontSize="14" />
						<TextBlock Text="Menu" />
					</StackPanel>
					<Button.Flyout>
						<MenuFlyout Placement="BottomEdgeAlignedLeft">
							<MenuFlyoutSubItem Text="File">
								<MenuFlyoutItem x:Name="OpenItem" Text="Open..." KeyboardAcceleratorTextOverride="Ctrl+O">
									<MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
								</MenuFlyoutItem>
								<!-- disabled until a tab is open, like NightPDF -->
								<MenuFlyoutItem Text="Print" KeyboardAcceleratorTextOverride="Ctrl+P" IsEnabled="False">
									<MenuFlyoutItem.Icon><FontIcon Glyph="&#xE749;" /></MenuFlyoutItem.Icon>
								</MenuFlyoutItem>
								<MenuFlyoutItem x:Name="SettingsItem" Text="Settings" KeyboardAcceleratorTextOverride="Alt+S">
									<MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
								</MenuFlyoutItem>
							</MenuFlyoutSubItem>
							<!-- Electron's edit and zoom roles act on the page, there's
								no page on the home screen -->
							<MenuFlyoutSubItem Text="Edit">
								<MenuFlyoutItem Text="Undo" KeyboardAcceleratorTextOverride="Ctrl+Z" IsEnabled="False" />
								<MenuFlyoutItem Text="Redo" KeyboardAcceleratorTextOverride="Ctrl+Y" IsEnabled="False" />
								<MenuFlyoutSeparator />
								<MenuFlyoutItem Text="Cut" KeyboardAcceleratorTextOverride="Ctrl+X" IsEnabled="False" />
								<MenuFlyoutItem Text="Copy" KeyboardAcceleratorTextOverride="Ctrl+C" IsEnabled="False" />
								<MenuFlyoutItem Text="Paste" KeyboardAcceleratorTextOverride="Ctrl+V" IsEnabled="False" />
							</MenuFlyoutSubItem>
							<MenuFlyoutSubItem Text="View">
								<!-- they zoom the document, the way pdf.js's own Ctrl+0, Ctrl++
									and Ctrl+- did. Enabled once a PDF is open. -->
								<MenuFlyoutItem x:Name="ResetZoomItem" Text="Reset Zoom" KeyboardAcceleratorTextOverride="Ctrl+0" IsEnabled="False" Click="onResetZoom" />
								<MenuFlyoutItem x:Name="ZoomInItem" Text="Zoom In" KeyboardAcceleratorTextOverride="Ctrl+Plus" IsEnabled="False" Click="onZoomIn" />
								<MenuFlyoutItem x:Name="ZoomOutItem" Text="Zoom Out" KeyboardAcceleratorTextOverride="Ctrl+-" IsEnabled="False" Click="onZoomOut" />
								<MenuFlyoutSeparator />
								<MenuFlyoutItem x:Name="FullScreenItem" Text="Toggle Full Screen" KeyboardAcceleratorTextOverride="F11" Click="onToggleFullScreen" />
							</MenuFlyoutSubItem>
							<MenuFlyoutSubItem Text="Window">
								<MenuFlyoutItem x:Name="MinimizeItem" Text="Minimize" KeyboardAcceleratorTextOverride="Ctrl+M" Click="onMinimize" />
							</MenuFlyoutSubItem>
							<!-- upstream's links point at NightPDF, these at Sable's repo.
								No Contact item until there's an address for it. -->
							<MenuFlyoutSubItem Text="Help">
								<MenuFlyoutItem x:Name="LearnMoreItem" Text="Learn More" Tag="https://github.com/abhilxsh07/sable" Click="onOpenLink" />
								<MenuFlyoutItem x:Name="LicenseItem" Text="License" Tag="https://github.com/abhilxsh07/sable/blob/main/LICENSE" Click="onOpenLink" />
								<MenuFlyoutItem x:Name="BugsItem" Text="Bugs" Tag="https://github.com/abhilxsh07/sable/issues" Click="onOpenLink" />
							</MenuFlyoutSubItem>
						</MenuFlyout>
					</Button.Flyout>
				</Button>
			</TitleBar.LeftHeader>
			<TitleBar.Content>
				<!-- the strip lives here; viewers stay mounted below it -->
				<TabView x:Name="Tabs" Height="48" Visibility="Collapsed"
					IsAddTabButtonVisible="False" CanReorderTabs="False"
					CanDragTabs="False" TabWidthMode="Equal"
					AutomationProperties.Name="Documents" />
			</TitleBar.Content>
			<TitleBar.RightHeader>
				<StackPanel x:Name="Presets" Orientation="Horizontal" Spacing="8"
					Margin="8,0" Visibility="Collapsed" Tapped="onKeepConfigurator">
					<Button x:Name="DefaultPreset" Tag="default" Content="Default" Click="onPresetClick" AutomationProperties.ItemStatus="Selected"
						Style="{StaticResource SablePresetButtonStyle}" Background="#1e2024" Foreground="#fbfbff" BorderBrush="#797979" />
					<Button x:Name="SepiaPreset" Tag="sepia" Content="Sepia" Click="onPresetClick"
						Style="{StaticResource SablePresetButtonStyle}" Background="#9e9174" Foreground="#40392d" />
					<Button x:Name="RedeyePreset" Tag="redeye" Content="Redeye" Click="onPresetClick"
						Style="{StaticResource SablePresetButtonStyle}" Background="#36272b" Foreground="#bc8b96" />
					<Button x:Name="CustomPreset" Tag="custom" Content="Custom" Click="onPresetClick"
						Style="{StaticResource SablePresetButtonStyle}" Background="#c1c1c1" Foreground="#232323" Padding="3.5,4" />
				</StackPanel>
			</TitleBar.RightHeader>
		</TitleBar>

		<!-- Recent and Starred filter the same list, the tools are shortcuts
			and don't stay selected. Below 1008px the pane folds down to icons;
			it never hides completely, there's no button to bring it back. -->
		<NavigationView x:Name="Nav" Grid.Row="1"
			PaneDisplayMode="Auto" CompactModeThresholdWidth="0"
			IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
			IsSettingsVisible="False" IsTitleBarAutoPaddingEnabled="False"
			OpenPaneLength="232" SelectionChanged="onNavSelectionChanged">
			<NavigationView.MenuItems>
				<NavigationViewItem Content="Recent" Tag="recent" IsSelected="True">
					<NavigationViewItem.Icon><FontIcon Glyph="&#xE823;" /></NavigationViewItem.Icon>
				</NavigationViewItem>
				<NavigationViewItem Content="Starred" Tag="starred">
					<NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" /></NavigationViewItem.Icon>
				</NavigationViewItem>
				<NavigationViewItemHeader Content="Tools" />
				<NavigationViewItem Content="Organize pages" SelectsOnInvoked="False">
					<NavigationViewItem.Icon><FontIcon Glyph="&#xE8A9;" /></NavigationViewItem.Icon>
				</NavigationViewItem>
				<NavigationViewItem Content="Combine files" SelectsOnInvoked="False">
					<NavigationViewItem.Icon><FontIcon Glyph="&#xE8C8;" /></NavigationViewItem.Icon>
				</NavigationViewItem>
				<NavigationViewItem Content="Fill &amp; Sign" SelectsOnInvoked="False">
					<NavigationViewItem.Icon><FontIcon Glyph="&#xE70F;" /></NavigationViewItem.Icon>
				</NavigationViewItem>
				<NavigationViewItem Content="Comment" SelectsOnInvoked="False">
					<NavigationViewItem.Icon><FontIcon Glyph="&#xE8BD;" /></NavigationViewItem.Icon>
				</NavigationViewItem>
				<NavigationViewItem Content="Export" SelectsOnInvoked="False">
					<NavigationViewItem.Icon><FontIcon Glyph="&#xEDE1;" /></NavigationViewItem.Icon>
				</NavigationViewItem>
				<NavigationViewItem Content="Read aloud" SelectsOnInvoked="False">
					<NavigationViewItem.Icon><FontIcon Glyph="&#xE767;" /></NavigationViewItem.Icon>
				</NavigationViewItem>
			</NavigationView.MenuItems>
			<NavigationView.FooterMenuItems>
				<NavigationViewItem Content="Settings" SelectsOnInvoked="False" ToolTipService.ToolTip="Settings (Alt+S)">
					<NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
				</NavigationViewItem>
			</NavigationView.FooterMenuItems>

			<local:HomePage x:Name="Home" />
		</NavigationView>

		<!-- each tab keeps its viewer and reading position while hidden -->
		<Grid x:Name="Documents" Grid.Row="1" Visibility="Collapsed" />
		<!-- #darkConfigurator in index.sass: 200 wide, at most 550 tall,
			rgb(45,45,45) with a #666 border, 16px 24px padding, 4px corners and
			a small shadow. Lined up under the preset buttons when it opens. -->
		<Border x:Name="DarkConfigurator" Grid.Row="1" Visibility="Collapsed"
			HorizontalAlignment="Right" VerticalAlignment="Top" Width="200"
			MaxHeight="550" Margin="0,0,8,8" Background="#2d2d2d"
			BorderBrush="#666666" BorderThickness="1" Padding="24,16"
			CornerRadius="4" Translation="0,0,8" Tapped="onKeepConfigurator">
			<Border.Shadow>
				<ThemeShadow />
			</Border.Shadow>
			<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<StackPanel Spacing="8">
					<TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
					<StackPanel x:Name="FilterSliders" Spacing="8" />
				</StackPanel>
			</ScrollViewer>
		</Border>
	</Grid>
</Window>
<!--trans rights-->
