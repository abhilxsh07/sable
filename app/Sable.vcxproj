		<!-- NightPDF shipped as a plain folder/installer, not a Store package,
			so no MSIX here. Self-contained so the Windows App SDK runtime
			ships next to the exe and nothing has to be installed first. -->
		<WindowsPackageType>None</WindowsPackageType>
		<AppxPackage>false</AppxPackage>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<!-- On ARM64 the inline C# tasks in the App SDK targets warn (CS1668)
			that LIB lists ARM64 ATL and .NET SDK folders that aren't installed.
			Neither is used here, so treat that one as a message. -->
		<MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);CS1668</MSBuildWarningsAsMessages>
	</PropertyGroup>
