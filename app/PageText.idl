namespace Sable
{
	// Holds the page image and gives screen readers the current page's text
	// through a UI Automation text pattern. The Image itself is sealed, so
	// it can't make its own automation peer.
	runtimeclass PageTextHost : Microsoft.UI.Xaml.Controls.Grid
	{
		PageTextHost();
		// "Page 3 of 10", the name Narrator reads for the document
		String PageName;
		// the page's text as PDFium extracts it
		String PageText;
	}

	[default_interface]
	runtimeclass PageTextPeer :
		Microsoft.UI.Xaml.Automation.Peers.FrameworkElementAutomationPeer,
		Microsoft.UI.Xaml.Automation.Provider.ITextProvider
	{
		PageTextPeer(PageTextHost owner);
	}
}
