	</ItemGroup>
	<ItemGroup>
		<CopyFileToFolders Include="assets\icon.png">
			<Filter>assets</Filter>
		</CopyFileToFolders>
		<CopyFileToFolders Include="assets\icon2.png">
			<Filter>assets</Filter>
		</CopyFileToFolders>
		<CopyFileToFolders Include="assets\icon.ico">
			<Filter>assets</Filter>
		</CopyFileToFolders>
		<CopyFileToFolders Include="assets\gradient.svg">
			<Filter>assets</Filter>
		</CopyFileToFolders>
		<CopyFileToFolders Include="assets\gradient2.svg">
			<Filter>assets</Filter>
		</CopyFileToFolders>
		<CopyFileToFolders Include="assets\gradient3.svg">
			<Filter>assets</Filter>
		</CopyFileToFolders>
	</ItemGroup>
	<ItemGroup>
		<Filter Include="assets">
			<UniqueIdentifier>{9E2A4D61-0B7C-4F3A-8E15-2C6D7B0A9F48}</UniqueIdentifier>
		</Filter>
	</ItemGroup>
	<ItemGroup>
