<Page
	x:Class="Sable.ViewerPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Sable">

	<Grid Background="{ThemeResource SableViewerBrush}">
		<!-- the surface is sized in physical pixels and the Image in DIPs, so
			Fill maps one onto the other without blurring. Zoom comes later. -->
		<ScrollViewer x:Name="Scroller" ZoomMode="Disabled"
			HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
			<Image x:Name="Pages" Stretch="Fill"
				HorizontalAlignment="Center" VerticalAlignment="Top" />
		</ScrollViewer>
		<TextBlock x:Name="Message" Visibility="Collapsed"
			HorizontalAlignment="Center" VerticalAlignment="Center"
			MaxWidth="480" TextWrapping="Wrap" TextAlignment="Center"
			Foreground="{ThemeResource SableTextSecondaryBrush}" />
	</Grid>
</Page>
