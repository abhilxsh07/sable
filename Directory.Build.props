<!-- Settings every C++ project in the solution should share. -->
<Project>
	<PropertyGroup>
		<!-- inline C# build tasks (the App SDK has some) warn with CS1668 when LIB
			lists ATL or .NET SDK lib folders that aren't installed, which
			happens on ARM64 and on the GitHub runner. Nothing here uses ATL, so
			treat that one as a message. -->
		<MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);CS1668</MSBuildWarningsAsMessages>
	</PropertyGroup>
	<PropertyGroup>
		<!-- versionString() reports these. VERSION and .pdfium_version are the
			real sources; the App SDK one has to match app/packages.config,
			which CheckWinAppSdkVersion below makes sure of. -->
		<SableVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</SableVersion>
		<SablePdfiumVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory).pdfium_version').Trim())</SablePdfiumVersion>
		<SableWinAppSdkVersion>2.5.1</SableWinAppSdkVersion>
	</PropertyGroup>
	<ItemDefinitionGroup>
		<ClCompile>
			<PreprocessorDefinitions>SABLE_VERSION="$(SableVersion)";SABLE_PDFIUM_VERSION="$(SablePdfiumVersion)";SABLE_WINAPPSDK_VERSION="$(SableWinAppSdkVersion)";%(PreprocessorDefinitions)</PreprocessorDefinitions>
			<LanguageStandard>stdcpp20</LanguageStandard>
			<!-- /permissive- -->
			<ConformanceMode>true</ConformanceMode>
			<WarningLevel>Level4</WarningLevel>
			<!-- the sources have non-ASCII literals (the easter egg flag, for one),
				so don't let MSVC guess the code page -->
			<AdditionalOptions>%(AdditionalOptions) /utf-8</AdditionalOptions>
			<TreatWarningAsError Condition="'$(CI)'=='true'">true</TreatWarningAsError>
			<!-- /FS. The App SDK's auto-initializer .cpp files build without the
				pch at the same time as everything else and they all write the same
				vc143.pdb (C1041 in Debug). VC only adds /FS by itself in
				multi-tool-task mode, see the comment in Microsoft.CppCommon.targets -->
			<ForceSynchronousPDBWrites>true</ForceSynchronousPDBWrites>
		</ClCompile>
	</ItemDefinitionGroup>

	<!-- Hybrid CRT for the app: static VC runtime + STL, dynamic UCRT.
		A self-contained build otherwise still needs the VC++ redistributable
		installed, which defeats the point.
		see: https://github.com/microsoft/WindowsAppSDK/blob/main/HybridCRT.props
		see: https://learn.microsoft.com/en-us/windows/apps/package-and-deploy/self-contained-deploy/deploy-self-contained-apps -->
	<ItemDefinitionGroup Condition="'$(MSBuildProjectName)'=='Sable' and '$(Configuration)'=='Debug'">
		<ClCompile>
			<RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
		</ClCompile>
		<Link>
			<IgnoreSpecificDefaultLibraries>%(IgnoreSpecificDefaultLibraries);libucrtd.lib</IgnoreSpecificDefaultLibraries>
			<AdditionalOptions>%(AdditionalOptions) /defaultlib:ucrtd.lib</AdditionalOptions>
		</Link>
	</ItemDefinitionGroup>
	<ItemDefinitionGroup Condition="'$(MSBuildProjectName)'=='Sable' and '$(Configuration)'=='Release'">
		<ClCompile>
			<RuntimeLibrary>MultiThreaded</RuntimeLibrary>
		</ClCompile>
		<Link>
			<IgnoreSpecificDefaultLibraries>%(IgnoreSpecificDefaultLibraries);libucrt.lib</IgnoreSpecificDefaultLibraries>
			<AdditionalOptions>%(AdditionalOptions) /defaultlib:ucrt.lib</AdditionalOptions>
		</Link>
	</ItemDefinitionGroup>

	<Target Name="CheckWinAppSdkVersion" BeforeTargets="PrepareForBuild" Condition="'$(MSBuildProjectName)'=='Sable'">
		<XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\packages.config" Query="/packages/package[@id='Microsoft.WindowsAppSDK']/@version">
			<Output TaskParameter="Result" PropertyName="_SablePackagesConfigSdk" />
		</XmlPeek>
		<Error Condition="'$(_SablePackagesConfigSdk)' != '$(SableWinAppSdkVersion)'" Text="SableWinAppSdkVersion ($(SableWinAppSdkVersion)) doesn't match Microsoft.WindowsAppSDK in packages.config ($(_SablePackagesConfigSdk)). Update Directory.Build.props." />
	</Target>
</Project>
